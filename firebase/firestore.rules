rules_version = '2';

// LocaLink Firestore rules - Production & Clean Architecture
// Configured to allow customers to discover services/places while protecting private data.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    // Any signed-in user (including guest sessions)
    function isReal() {
      return signedIn();
    }
    function uid() {
      return request.auth.uid;
    }
    function isAdmin() {
      return isReal() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function reqData(rid) {
      return get(/databases/$(database)/documents/requests/$(rid)).data;
    }
    function isParticipant(rid) {
      return isReal() && (reqData(rid).customerId == uid() || reqData(rid).providerId == uid());
    }
    function ownsDoc() {
      return isReal() && resource.data.get('userId', resource.data.get('providerId', '')) == uid();
    }
    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ---------- admins / config ----------
    match /admins/{adminId} {
      allow read: if isReal() && adminId == uid();
      allow write: if false;
    }

    match /config/{docId} {
      allow read: if true; // Public read fixes the "shopProducts is missing" warning
      allow write: if isAdmin();
    }

    // ---------- users ----------
    match /users/{userId} {
      allow read: if true;
      allow create: if signedIn() && userId == uid();
      // Allow users to update their profile and upgrade roles (e.g. customer -> provider / placeOwner)
      allow update: if signedIn() && (userId == uid() || isAdmin());
      allow delete: if false;

      match /devices/{token} {
        allow read, write: if signedIn() && userId == uid();
      }
      match /emergency_contacts/{contactId} {
        allow read, write: if signedIn() && userId == uid();
      }
      match /notifications/{notifId} {
        allow read: if signedIn() && userId == uid();
        allow update: if signedIn() && userId == uid() && changedKeys().hasOnly(['read']);
        allow create, delete: if false;
      }
    }

    // ---------- listings (service provider, place, shop) ----------
    match /listings/{listingId} {
      // Public read: any customer/guest can view active listings
      allow read: if true;

      // Authenticated owners can create their listing
      allow create: if signedIn()
        && request.resource.data.ownerId == uid()
        && request.resource.data.status in ['pending', 'active'];

      // Owner or Admin can update their listing
      allow update: if isAdmin()
        || (signedIn() && resource.data.ownerId == uid());
      allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == uid());

      // Reviews
      match /reviews/{reviewerId} {
        allow read: if true;
        allow create: if signedIn() && reviewerId == uid();
        allow update, delete: if false;
      }
    }

    // views / calls / directions counters
    match /listing_stats/{listingId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    // ---------- reports and claims ----------
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /claims/{claimId} {
      allow read: if isAdmin() || (signedIn() && resource.data.claimantId == uid());
      allow create: if signedIn() && request.resource.data.claimantId == uid();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- service requests ----------
    match /requests/{requestId} {
      allow read: if signedIn() && (
        resource.data.customerId == uid()
        || resource.data.providerId == uid()
        || isAdmin()
      );

      allow create: if signedIn()
        && request.resource.data.customerId == uid();

      allow update: if signedIn() && (
        // customer cancels or provider updates progress
        (resource.data.customerId == uid() && request.resource.data.status == 'cancelled')
        || (resource.data.providerId == uid())
        || isAdmin()
      );
      allow delete: if false;

      match /private/{docId} {
        allow read, write: if signedIn();
      }

      match /messages/{messageId} {
        allow read: if isParticipant(requestId);
        allow create: if signedIn() && request.resource.data.senderId == uid();
        allow update, delete: if false;
      }

      match /live/{docId} {
        allow read, write: if signedIn();
      }
    }

    // ---------- leads ----------
    match /leads/{leadId} {
      allow read, write: if signedIn();
    }

    // ---------- providers (PRIVATE) ----------
    match /providers/{providerId} {
      allow read: if signedIn() && (providerId == uid() || isAdmin());
      allow create: if signedIn() && providerId == uid();
      allow update: if signedIn() && (providerId == uid() || isAdmin());
      allow delete: if false;
    }

    // ---------- money ----------
    match /wallets/{walletId} {
      allow read: if signedIn() && walletId == uid();
      allow write: if false;
    }
    match /wallet_txns/{txnId} {
      allow read: if signedIn();
      allow write: if false;
    }
    match /payments/{paymentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // ---------- AI ----------
    match /ai_sessions/{sessionId} {
      allow read, write: if signedIn();
    }
    match /plans/{planId} {
      allow read, write: if signedIn();
    }

    // ---------- feedback and SOS ----------
    match /feedback/{feedbackId} {
      allow create: if signedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /sos_events/{eventId} {
      allow create, read, update: if signedIn();
    }
  }
}
