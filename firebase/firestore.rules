rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Listings (Services, Shops, Places)
    // Public read so guests and all customers can view active listings everywhere.
    // Authenticated users can create or edit their listings.
    match /listings/{listingId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null;
      }
    }

    // 2. App configuration (categories, shopProducts, etc.)
    match /config/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 3. User profiles and subcollections (devices, emergency contacts, notifications)
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }

    // 4. Providers collection (private profile & documents)
    match /providers/{providerId} {
      allow read, write: if request.auth != null;
    }

    // 5. Service requests, leads, messages, live GPS tracking
    match /requests/{requestId} {
      allow read, write: if request.auth != null;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null;
      }
    }

    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // 6. Emergency SOS, feedback, reports, and claims
    match /sos_events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /feedback/{feedbackId} {
      allow read, write: if request.auth != null;
    }

    match /reports/{reportId} {
      allow read, write: if request.auth != null;
    }

    match /claims/{claimId} {
      allow read, write: if request.auth != null;
    }

    match /listing_stats/{listingId} {
      allow read, write: if request.auth != null;
    }

    // 7. Backward compatibility for direct places or shops matches
    match /places/{placeId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /shops/{shopId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Master catch-all for authenticated users
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
